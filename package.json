{
  "name": "hodoor-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Hodoor AI (حضور AI) – smart school attendance prototype using on-device face detection",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-mediapipe.mjs",
    "dev": "vite --host",
